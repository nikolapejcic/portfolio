{
  // Cloudflare Workers config: serves v2-figma behind a login.
  "name": "portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./v2-figma",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // SITE_USER only keeps older cookies and Basic Auth logins working.
  "vars": { "SITE_USER": "guest" },
  // Login attempts: at most 10 login attempts per minute per visitor IP (free plan).
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "keep_vars": true
}
